FOUNDRY_PROFILE=default

# Deployer (Besu genesis account #1 for local dev)
DEPLOYER_PRIVATE_KEY=

# Governance admin key used for IdentityRegistry writes in local dev
ADMIN_PRIVATE_KEY=

# Central bank key used for token mint/burn during hub seeding
# Must match central-bank-a's SIGNER_PRIVATE_KEY (backend/config/.env.infra.central-bank-a)
CENTRAL_BANK_PRIVATE_KEY=

# RBAC addresses (use Besu genesis accounts for local dev)
# CENTRAL_BANK_ADDRESS must match the address derived from CENTRAL_BANK_PRIVATE_KEY
ADMIN_ADDRESS=
CENTRAL_BANK_ADDRESS=
# CB-A hub identity key — distinct from the spoke signer (CENTRAL_BANK_PRIVATE_KEY / 0x627306).
# Used by contracts.grant-cb-a-hub-roles to grant DEFAULT_ADMIN_ROLE on the Hub IdentityRegistry
# and CENTRAL_BANK_ROLE on W-tCeBM_A, and by sync-contracts.sh to compute LOCAL_CB_HUB_SIGNER for CB-A.
CENTRAL_BANK_A_PRIVATE_KEY=
# CB-A hub identity address (derived from CENTRAL_BANK_A_PRIVATE_KEY above).
CENTRAL_BANK_A_ADDRESS=
# CB-B hub identity key — used by SeedNewSovereignPair to grant CENTRAL_BANK_ROLE on W-tCeBM_B
# and by sync-contracts.sh to compute LOCAL_CB_HUB_SIGNER (used by api-gateway CB-B for
# ExecuteMatchedCommit validation). This is a SEPARATE identity from SIGNER_PRIVATE_KEY in CB-B;
# the runtime mint/burn signer is ADMIN_PRIVATE_KEY (set as SIGNER_PRIVATE_KEY in backend compose).
# sync-contracts.sh automatically grants CENTRAL_BANK_ROLE to ADMIN on all hub/sovereign tokens.
CENTRAL_BANK_B_PRIVATE_KEY=
# CB-B hub identity address (derived from CENTRAL_BANK_B_PRIVATE_KEY above).
CENTRAL_BANK_B_ADDRESS=

# Hub Besu (chain 1337) — independent international hub network (hub-besu/)
HUB_RPC_URL=http://127.0.0.1:8845
HUB_CHAIN_ID=1337

# Spoke-A Besu (chain 1338)
SPOKE_A_RPC_URL=http://127.0.0.1:8645

# Spoke-B Besu (chain 1339)
SPOKE_B_RPC_URL=http://127.0.0.1:8745

# Legacy: standalone script support (defaults to hub)
BESU_RPC_URL=http://127.0.0.1:8545
TOKEN_A_ADDRESS=
TOKEN_B_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
