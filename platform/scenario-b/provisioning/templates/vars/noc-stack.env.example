# noc-stack.compose.yaml — variable contract (NOC control plane, observe mode).
# Standalone participant: owns its network; no fixed spoke identifiers.
CONTAINER_PREFIX=sc-b-cbweb3-noc
NOC_DB_USER=cbweb3
NOC_DB_PASSWORD=change-me-local
NOC_DB_NAME=noc
NOC_BACKEND_PORT=8090
NOC_PORTAL_PORT=3030
NOC_NET_PREFIX=sc-b-cbweb3-noc
NOC_VOLUME_PREFIX=sc-b-cbweb3-noc
# CORS origin for the portal. Mandatory and never "*": a browser refuses to send
# credentials to a wildcard origin, and the NOC session is a cookie.
NOC_FRONTEND_ORIGIN=http://localhost:3030
# Keycloak the backend password-grants against. Empty is valid only alongside
# NOC_SKIP_AUTH=true, which keeps the no-op validator for a stack with no realm.
NOC_KEYCLOAK_URL=http://localhost:8081
NOC_KEYCLOAK_REALM=cbweb3
NOC_KEYCLOAK_CLIENT_ID=noc-portal
NOC_SKIP_AUTH=true
# Session cookies over plain HTTP locally: a browser discards a Secure cookie on an
# insecure origin, which looks like a login that works and a session that does not exist.
NOC_COOKIE_SECURE=false
# Keys the HMAC binding each CSRF token to its session. Stable per stack.
NOC_CSRF_SECRET=local-development-csrf-secret
