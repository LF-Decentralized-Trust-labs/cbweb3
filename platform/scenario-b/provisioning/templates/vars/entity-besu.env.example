# entity-besu.compose.yaml — variable contract. Example: bank-a (offset 10).
CONTAINER_PREFIX=cbweb3-b
ENTITY=bank-a
BOOTNODE_ENODE=enode://0000@host.docker.internal:30303
ENTITY_RPC_PORT=8855
ENTITY_WS_PORT=8856
ENTITY_P2P_PORT=30313
ENTITY_PALADIN_PORT=8558
PKI_DIR=/srv/cbweb3/bank-a/pki
ENTITY_NET_PREFIX=bank_a
ENTITY_VOLUME_PREFIX=bank_a
# optional (non-discriminant):
BESU_IMAGE=hyperledger/besu:25.8.0
PALADIN_IMAGE=lfdt-labs/paladin:latest
