# noc-agent.compose.yaml — variable contract (one agent per entity).
# The agent.yaml (spoke_id, api_key, backend URL, components) is seeded into the
# named config volume by the toolkit; nothing here is a secret.
CONTAINER_PREFIX=sc-b-cbweb3-central-bank
NOC_AGENT_ENTITY=central-bank
NOC_AGENT_IMAGE=cbweb3b/noc-agent:local
ENTITY_NET_PREFIX=central-bank
NOC_AGENT_VOLUME=central-bank_noc_agent_cfg
