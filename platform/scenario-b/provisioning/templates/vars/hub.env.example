# hub.compose.yaml — variable contract. Ports per vars/NAMING.md (offset 0).
HUB_CONTAINER_PREFIX=cbweb3-b
HUB_RPC_PORT=8845
HUB_WS_PORT=8846
HUB_P2P_PORT=30303
HUB_NET_PREFIX=hub
HUB_VOLUME_PREFIX=hub
# optional (non-discriminant):
BESU_IMAGE=hyperledger/besu:25.8.0
# Ceiling on concurrent WebSocket RPC connections: an integer from 1 to 2147483647,
# default 256. cbweb3b apply validates it and writes it into the env it renders.
BESU_RPC_WS_MAX_ACTIVE_CONNECTIONS=256
