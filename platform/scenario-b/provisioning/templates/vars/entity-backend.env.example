# entity-backend.compose.yaml — variable contract. Example: bank-a (offset 10).
CONTAINER_PREFIX=cbweb3-b
ENTITY=bank-a
HUB_RPC_PORT=8845
ENTITY_RPC_PORT=8855
GATEWAY_PORT=8090
ENTITY_NET_PREFIX=bank_a
# Credentials are REQUIRED, with no fallback (${VAR:?} in the template). A template
# that defaults to a value ships that value to every deployment that does not set it,
# which is a hardcoded credential wearing a parameter's clothes. `cbweb3` used to be
# that value for every entity of every network.
#
# When provisioning through the toolkit you do not set these by hand: it generates one
# per entity on first `apply`, persists it 0600 in <dataDir>/.infra-secrets.env, and
# reads it back on later runs (Postgres keeps the password it was initialised with, so
# a regenerated value would lock the stack out of its own database). Export the
# variable yourself to override, and it is then NOT written to disk.
POSTGRES_PASSWORD=change-me-local
REDIS_PASSWORD=change-me-local
# PKI volumes: the consortium CA (cb_tls) and the R2-H-8 service-mesh CA/leaves.
CA_VOLUME=bank_a_cb_tls
ENTITY_PKI_DIR=cb_tls
SVC_TLS_VOLUME=bank_a_svc_tls
# Signer + Keycloak client secret. Both are NON-FUNCTIONAL PLACEHOLDERS: this file
# documents the variable contract of entity-backend.compose.yaml and is the env the
# composetemplate test suite interpolates it against. It is never read by a deploy.
# At apply time the toolkit supplies the real values in the process environment
# (engine/orchestrator; see exec.Runner) — the compose file mandates them with
# ${CB_PRIVATE_KEY:?}, so an empty value aborts the deploy instead of falling back.
# Never put key material here — see docs/secret-management.md.
CB_PRIVATE_KEY=0xREPLACE_ME
KEYCLOAK_CLIENT_SECRET=REPLACE_ME
