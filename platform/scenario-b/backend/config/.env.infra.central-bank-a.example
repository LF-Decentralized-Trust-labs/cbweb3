# Infra (Compose)
KEYCLOAK_CONTAINER_NAME=cbweb3-keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ENV_OUTPUT_DIR=/opt/keycloak/host/backend/config
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

POSTGRES_CONTAINER_NAME=cbweb3-postgres
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=default
POSTGRES_PASSWORD=default
POSTGRES_DB_CENTRAL_BANK_A=cbweb3_central_bank_a

REDIS_CONTAINER_NAME=cbweb3-redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379

# Domain defaults (central-bank-a)
BANK_CODE=central-bank-a
KC_BASE_PATH=http://localhost:8081
KC_REALM=central-bank-a
KC_CLIENT_ID=central-bank-a-client
KC_CLIENT_SECRET=central-bank-a-local-secret
DB_NAME=cbweb3_central_bank_a
DATABASE_URL=postgres://default:default@${POSTGRES_CONTAINER_NAME:-cbweb3-postgres}:5432/cbweb3_central_bank_a?sslmode=disable

# Redis isolation — central-bank-a uses DB 2
REDIS_DB=2

# PKI — central-bank-a root CA (required to sign CSRs and for governance bootstrap)
# Local dev: generate with `openssl` — see backend/config/pki/README.md
CA_CERT_FILE=/workspace/backend/config/pki/central-bank-a-ca.crt
CA_KEY_FILE=/workspace/backend/config/pki/central-bank-a-ca.key
# Production (Docker Secrets): uncomment below and comment out the lines above
#CA_CERT_FILE=/run/secrets/ca.crt
#CA_KEY_FILE=/run/secrets/ca.key

# Blockchain — spoke-a Besu node (chain 1338)
# bank-a, bank-c and central-bank-a all share the same spoke-a Besu network.
# Contract addresses below are populated automatically by `make contracts.sync-addresses` after deployment.
# Local dev reference addresses (genesis deploy via `make deploy.up-with-contracts`):
BLOCKCHAIN_CLIENT=besu
BESU_RPC_URL=http://cbweb3-spoke-a-besu.central-bank-a:8545
BESU_CHAIN_ID=1338
# CB-A identity key (0xfe3b557e...) — distinct from the platform admin/deployer (0x627306)
# and from CB-B (0xf17f). Derives the governance/auth wallet (/auth/me).
CB_PRIVATE_KEY=8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63
# Signer for tCeBM mint/burn on spoke-a — must match the address with CENTRAL_BANK_ROLE in
# TokenizedCentralBankMoney. spoke-a is deployed with CENTRAL_BANK_ADDRESS=0xfe3b557e... (CB-A).
SIGNER_PRIVATE_KEY=8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63
# CB-A hub identity key — same 0xfe3b557e... identity used as the api-gateway Hub SIGNER and
# as LOCAL_CB_HUB_SIGNER. Distinct from CB-B (0xf17f) and the platform admin (0x627306).
CENTRAL_BANK_A_PRIVATE_KEY=8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63

# IdentityRegistry — whitelist of approved participants (KYC/AML registry)
PARTICIPANT_REGISTRY_ADDRESS=0x8cdaf0cd259887258bc13a92c0a6da92698644c0

# TokenizedCentralBankMoney (EUR) — tCeBM token for Euro
#TOKEN_EUR_ADDRESS=0x9a3dbca554e9f6b9257aaa24010da8377c57c17e

# HashTimeLockedContract — atomic cross-chain swap escrow
HTLC_ADDRESS=0x345ca3e014aaf5dca488057592ee47305d9b3e10

# AutomatedMarketMaker — on-chain FX liquidity pool
#AMM_ADDRESS=0x2e1f232a9439c3d459fceca0beef13acc8259dd8

# FXAgreement — bilateral FX settlement agreement between central banks
#FX_AGREEMENT_ADDRESS=0x05d91b9031a655d08e654177336d08543ac4b711

# ManualOracle — price feed oracle for FX rates (updated by the central bank)
ORACLE_ADDRESS=0xfb88de099e13c3ed21f80a7a1e49f8caecf10df6

# Governance bootstrap — Keycloak service-account subject for central-bank-a.
# Used by the compliance service (governance.go) to register the governance
# participant on first startup. Only applicable to central banks.
# Created automatically by init.sh.
GOVERNANCE_USER_ID=148a3666-16e3-47aa-924a-13fee296433f
GOVERNANCE_BANK_CODE=central-bank-a

# Internal relay auth (R2-CR-6 migration).
# Per-CB asymmetric signatures are the real authentication: each gateway signs internal
# relay calls with its PKI key (PKI_DIR/<BANK_CODE>.key) and verifies callers against the
# pinned peer certs (PKI_DIR/<entity>.crt). The shared secret below is only a LEGACY
# FALLBACK for callers that do not sign yet (notably the Cacti TS relay).
# Set RELAY_REQUIRE_SIGNATURE=true to reject any request without a valid signature
# (post-cutover, once Cacti forwards signature headers). Default false.
INTERNAL_RELAY_AUTH_SECRET=cbweb3-relay-shared-secret
RELAY_REQUIRE_SIGNATURE=false

# Payment Orchestrator gRPC address (optional; enables /api/v1/payments/* and /api/v1/token/* endpoints)
# When set on central banks: enables PaymentHandler (direct gRPC, includes approve/reject operations).
# Format: payment-orchestrator-<entity>:9094
PAYMENT_GRPC_ADDR=payment-orchestrator-central-bank-a:9094

# Frontend dev server CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5177,http://localhost:5179,http://localhost:5181
#BANK_A_FRONTEND_PORT=5173
#BANK_B_FRONTEND_PORT=5174
#BANK_C_FRONTEND_PORT=5175
#BANK_D_FRONTEND_PORT=5176
CENTRAL_BANK_A_FRONTEND_PORT=5177
#CENTRAL_BANK_B_FRONTEND_PORT=5178
TOKEN_ADDRESS=0xf12b5dd4ead5f743c6baa640b0216200e89b60da
FIAT_TOKEN_ADDRESS=0x8f0483125fcb9aaaefa9209d8e9d7b9c8b9fb90f
SPOKE_BRIDGE_ADDRESS=0xf25186b5081ff5ce73482ad761db0eb0d25abfbf
AMM_CONTRACT_ADDRESS=0x9fbda871d559710256a2502a2517b794b482db40
HUB_BESU_RPC_URL=http://host.docker.internal:8845
HUB_CHAIN_ID=1337
HUB_IDENTITY_REGISTRY_ADDRESS=0x8cdaf0cd259887258bc13a92c0a6da92698644c0
HUB_TOKEN_A_ADDRESS=0xf12b5dd4ead5f743c6baa640b0216200e89b60da
HUB_TOKEN_B_ADDRESS=0x345ca3e014aaf5dca488057592ee47305d9b3e10
CURRENCY_REGISTRY_CONTRACT_ADDRESS=0x30753e4a8aad7f8597332e813735def5dd395028
PAIR_REGISTRY_CONTRACT_ADDRESS=0x2c2b9c9a4a25e24b174f26114e8926a9f2128fe4
LOCAL_CB_HUB_SIGNER=0xFE3B557E8Fb62b89F4916B721be55cEb828dBd73
HUB_MINT_RECIPIENT=0xFE3B557E8Fb62b89F4916B721be55cEb828dBd73
LIQUIDITY_COMMIT_REGISTRY_ADDRESS=0xa4392264a2d8c998901d10c154c91725b1bf0158
SOVEREIGN_HUB_TOKEN_A_ADDRESS=0x38cf23c52bb4b13f051aec09580a2de845a7fa35
SOVEREIGN_HUB_TOKEN_B_ADDRESS=0x4e72770760c011647d4873f60a3cf6cdea896cd8
SOVEREIGN_AMM_ADDRESS=0x42699a7612a82f1d9c36148af9c77354759b210b
SOVEREIGN_PAIR_AMM_MAP={"W-BRL-ARS":"0x42699a7612a82f1d9c36148af9c77354759b210b"}

# Simplified bridge/liquidity config (008-fix-cb-liquidity refactor)
SPOKE_NETWORK=spoke-a
# NATIVE_ASSET_SYMBOL must be the spoke-a tCeBM contract address (not a symbol string):
# spokeLock()/ensureSpokeFunds() pass it to common.HexToAddress(). Re-synced by
# `make contracts.sync-addresses` from the spoke-a deployment.
NATIVE_ASSET_SYMBOL=0xf12b5dd4ead5f743c6baa640b0216200e89b60da
FIAT_SYMBOL=BRL
W_TOKEN_ADDRESS=0x38cf23c52bb4b13f051aec09580a2de845a7fa35
# BANK_CODE=central-bank-a → CommitSide=A (derived automatically)
