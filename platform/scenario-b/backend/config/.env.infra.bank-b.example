# Infra (Compose)
KEYCLOAK_CONTAINER_NAME=cbweb3-keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ENV_OUTPUT_DIR=/opt/keycloak/host/backend/config
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

POSTGRES_CONTAINER_NAME=cbweb3-postgres
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=default
POSTGRES_PASSWORD=default
POSTGRES_DB_BANK_B=cbweb3_bank_b

REDIS_CONTAINER_NAME=cbweb3-redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379

# Domain defaults (bank-b)
KC_BASE_PATH=http://localhost:8081
KC_REALM=bank-b
KC_CLIENT_ID=bank-b-client
KC_CLIENT_SECRET=bank-b-local-secret
DB_NAME=cbweb3_bank_b
DATABASE_URL=postgres://default:default@${POSTGRES_CONTAINER_NAME:-cbweb3-postgres}:5432/cbweb3_bank_b?sslmode=disable

# Redis isolation — bank-b uses DB 1
REDIS_DB=1

# PKI — bank-b root CA (used to sign commercial bank CSRs)
# Local dev: generate with `openssl` — see backend/config/pki/README.md
CA_CERT_FILE=/workspace/backend/config/pki/bank-b-ca.crt
CA_KEY_FILE=/workspace/backend/config/pki/bank-b-ca.key
# Production (Docker Secrets): uncomment below and comment out the lines above
#CA_CERT_FILE=/run/secrets/ca.crt
#CA_KEY_FILE=/run/secrets/ca.key

# Blockchain — spoke-b Besu node (chain 1339)
# central-bank-b, bank-b and bank-d all share the same spoke-b Besu network.
# Contract addresses below are populated automatically by `make contracts.sync-addresses` after deployment.
# Local dev reference addresses (genesis deploy via `make deploy.up-with-contracts`):
BLOCKCHAIN_CLIENT=besu
BESU_RPC_URL=http://cbweb3-spoke-b-besu.bank-b:8545
BESU_CHAIN_ID=1339

# Populated automatically by `make contracts.sync-addresses` after deployment.
PARTICIPANT_REGISTRY_ADDRESS=0x8cdaf0cd259887258bc13a92c0a6da92698644c0
TOKEN_ADDRESS=0xf12b5dd4ead5f743c6baa640b0216200e89b60da
FIAT_TOKEN_ADDRESS=0x8f0483125fcb9aaaefa9209d8e9d7b9c8b9fb90f
HTLC_ADDRESS=0x345ca3e014aaf5dca488057592ee47305d9b3e10
FX_AGREEMENT_ADDRESS=
SPOKE_BRIDGE_ADDRESS=0xf25186b5081ff5ce73482ad761db0eb0d25abfbf

# Inter-entity communication — Central Bank API (for 3-phase onboarding)
# When set, the API Gateway acts as a commercial bank and proxies onboarding calls to the CB.
CENTRAL_BANK_API_URL=http://api-gateway-central-bank-b:8080

# Frontend dev server CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5174
#BANK_A_FRONTEND_PORT=5173

# FX Agreement persistence (payment-orchestrator PostgreSQL)
FX_POSTGRES_DSN=postgres://default:default@${POSTGRES_CONTAINER_NAME:-cbweb3-postgres}:5432/cbweb3_bank_b?sslmode=disable

# FX Agreement validation
FX_RATE_TOLERANCE_PCT=0.001

# Expiry worker: interval in seconds (default 300).
FX_EXPIRY_CHECK_INTERVAL_S=300

# Internal relay auth (R2-CR-6 migration). Real auth is the per-CB PKI signature
# (PKI_DIR/<BANK_CODE>.key); this shared secret is only a LEGACY FALLBACK for unsigned
# callers. Set RELAY_REQUIRE_SIGNATURE=true to enforce signatures post-cutover.
INTERNAL_RELAY_AUTH_SECRET=cbweb3-relay-shared-secret
RELAY_REQUIRE_SIGNATURE=false

# Payment Orchestrator gRPC address (optional; enables /api/v1/payments/* and /api/v1/token/* endpoints)
# When set on commercial banks: enables PaymentProxyHandler (proxy to Central Bank) + PaymentHandler (token balance).
# Format: payment-orchestrator-<entity>:9094
PAYMENT_GRPC_ADDR=payment-orchestrator-bank-b:9094

# Central Bank token recipient address (Besu address).
# Used by commercial banks for redeem flow: tokens are transferred to this address before de-tokenization request.
# Populated automatically by `deploy/local/tools/sync-contracts.sh` from contracts/.env private keys.
CB_TOKEN_RECIPIENT_ADDRESS=0xf17f52151EbEF6C7334FAD080c5704D77216b732

# Strict agreement linkage for HTLC lock operations.
# Keep false in local dev while FX_AGREEMENT_ADDRESS is not configured.
FX_AGREEMENT_HTLC_STRICT=false

BANK_B_FRONTEND_PORT=5174
#BANK_C_FRONTEND_PORT=5175
#BANK_D_FRONTEND_PORT=5176
#CENTRAL_BANK_A_FRONTEND_PORT=5177
#CENTRAL_BANK_B_FRONTEND_PORT=5178
AMM_CONTRACT_ADDRESS=0x9fbda871d559710256a2502a2517b794b482db40
HUB_BESU_RPC_URL=http://host.docker.internal:8845
HUB_CHAIN_ID=1337
HUB_IDENTITY_REGISTRY_ADDRESS=0x8cdaf0cd259887258bc13a92c0a6da92698644c0
HUB_TOKEN_A_ADDRESS=0xf12b5dd4ead5f743c6baa640b0216200e89b60da
HUB_TOKEN_B_ADDRESS=0x345ca3e014aaf5dca488057592ee47305d9b3e10
PAIR_REGISTRY_CONTRACT_ADDRESS=0x2c2b9c9a4a25e24b174f26114e8926a9f2128fe4
SOVEREIGN_AMM_ADDRESS=0xecfcab0a285d3380e488a39b4bb21e777f8a4eac
SOVEREIGN_PAIR_AMM_MAP={"W-BRL-ARS":"0xecfcab0a285d3380e488a39b4bb21e777f8a4eac"}

# Simplified bridge/liquidity config — spoke identity and wrapped token for this bank's spoke
SPOKE_NETWORK=spoke-b
NATIVE_ASSET_SYMBOL=0xf12b5dd4ead5f743c6baa640b0216200e89b60da
W_TOKEN_ADDRESS=0x4e72770760c011647d4873f60a3cf6cdea896cd8
