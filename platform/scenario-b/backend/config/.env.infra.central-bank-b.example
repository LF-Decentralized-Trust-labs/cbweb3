# Infra (Compose)
KEYCLOAK_CONTAINER_NAME=cbweb3-keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ENV_OUTPUT_DIR=/opt/keycloak/host/backend/config
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

POSTGRES_CONTAINER_NAME=cbweb3-postgres
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=default
POSTGRES_PASSWORD=default
POSTGRES_DB_CENTRAL_BANK_B=cbweb3_central_bank_b

REDIS_CONTAINER_NAME=cbweb3-redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379

# Domain defaults (central-bank-b)
BANK_CODE=central-bank-b
KC_BASE_PATH=http://localhost:8081
KC_REALM=central-bank-b
KC_CLIENT_ID=central-bank-b-client
KC_CLIENT_SECRET=central-bank-b-local-secret
DB_NAME=cbweb3_central_bank_b
DATABASE_URL=postgres://default:default@${POSTGRES_CONTAINER_NAME:-cbweb3-postgres}:5432/cbweb3_central_bank_b?sslmode=disable

# Redis isolation — central-bank-b uses DB 5
REDIS_DB=5

# PKI — central-bank-b root CA (required to sign CSRs and for governance bootstrap)
# Local dev: generate with `openssl` — see backend/config/pki/README.md
CA_CERT_FILE=/workspace/backend/config/pki/central-bank-b-ca.crt
CA_KEY_FILE=/workspace/backend/config/pki/central-bank-b-ca.key
# Production (Docker Secrets): uncomment below and comment out the lines above
#CA_CERT_FILE=/run/secrets/ca.crt
#CA_KEY_FILE=/run/secrets/ca.key

# Blockchain — spoke-b Besu node (chain 1339)
# central-bank-b, bank-b and bank-d all share the same spoke-b Besu network.
# Contract addresses below are populated automatically by `make contracts.sync-addresses` after deployment.
# Local dev reference addresses (genesis deploy via `make deploy.up-with-contracts`):
BLOCKCHAIN_CLIENT=besu
BESU_RPC_URL=http://cbweb3-spoke-b-besu.central-bank-b:8545
BESU_CHAIN_ID=1339
CB_PRIVATE_KEY=c87509a1c067bbde78beb793e6fa76530b6382a4c0241e5e4a9ec0a0f44dc0d3
# Signer for tCeBM mint/burn on spoke-b — must match the address with CENTRAL_BANK_ROLE in TokenizedCentralBankMoney
SIGNER_PRIVATE_KEY=c87509a1c067bbde78beb793e6fa76530b6382a4c0241e5e4a9ec0a0f44dc0d3

# IdentityRegistry — whitelist of approved participants (KYC/AML registry)
PARTICIPANT_REGISTRY_ADDRESS=0x42699a7612a82f1d9c36148af9c77354759b210b

# TokenizedCentralBankMoney (EUR) — tCeBM token for Euro
#TOKEN_EUR_ADDRESS=0x9a3dbca554e9f6b9257aaa24010da8377c57c17e

# HashTimeLockedContract — atomic cross-chain swap escrow
HTLC_ADDRESS=0x9a3dbca554e9f6b9257aaa24010da8377c57c17e

# AutomatedMarketMaker — on-chain FX liquidity pool
#AMM_ADDRESS=0x2e1f232a9439c3d459fceca0beef13acc8259dd8

# FXAgreement — bilateral FX settlement agreement between central banks
#FX_AGREEMENT_ADDRESS=0x05d91b9031a655d08e654177336d08543ac4b711

# ManualOracle — price feed oracle for FX rates (updated by the central bank)
#ORACLE_ADDRESS=0xfeae27388a65ee984f452f86effed42aabd438fd

# Governance bootstrap — Keycloak service-account subject for central-bank-b.
# Used by the compliance service (governance.go) to register the governance
# participant on first startup. Only applicable to central banks.
# Created automatically by init.sh.
GOVERNANCE_USER_ID=f6ff94ee-9302-497c-a867-747451822025
GOVERNANCE_BANK_CODE=central-bank-b

# Internal relay auth: shared secret for X-Relay-Auth header — must match all entities and cacti relay.
INTERNAL_RELAY_AUTH_SECRET=cbweb3-relay-shared-secret

# Payment Orchestrator gRPC address (optional; enables /api/v1/payments/* and /api/v1/token/* endpoints)
# When set on central banks: enables PaymentHandler (direct gRPC, includes approve/reject operations).
# Format: payment-orchestrator-<entity>:9094
PAYMENT_GRPC_ADDR=payment-orchestrator-central-bank-b:9094

# Frontend dev server CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5178
#BANK_A_FRONTEND_PORT=5173
#BANK_B_FRONTEND_PORT=5174
#BANK_C_FRONTEND_PORT=5175
#BANK_D_FRONTEND_PORT=5176
#CENTRAL_BANK_A_FRONTEND_PORT=5177
CENTRAL_BANK_B_FRONTEND_PORT=5178
TOKEN_ADDRESS=0xa50a51c09a5c451c52bb714527e1974b686d8e77
FIAT_TOKEN_ADDRESS=0x2e1f232a9439c3d459fceca0beef13acc8259dd8
SPOKE_BRIDGE_ADDRESS=0x9b8397f1b0fecd3a1a40cdd5e8221fa461898517
AMM_CONTRACT_ADDRESS=0x05d91b9031a655d08e654177336d08543ac4b711
HUB_CHAIN_ID=1338
HUB_IDENTITY_REGISTRY_ADDRESS=0x42699a7612a82f1d9c36148af9c77354759b210b
HUB_TOKEN_A_ADDRESS=0xa50a51c09a5c451c52bb714527e1974b686d8e77
HUB_TOKEN_B_ADDRESS=0x9a3dbca554e9f6b9257aaa24010da8377c57c17e
CURRENCY_REGISTRY_CONTRACT_ADDRESS=0xe135783649bfa7c9c4c6f8e528c7f56166efc8a6
PAIR_REGISTRY_CONTRACT_ADDRESS=0xfeae27388a65ee984f452f86effed42aabd438fd
LOCAL_CB_HUB_SIGNER=0xf17f52151EbEF6C7334FAD080c5704D77216b732
HUB_MINT_RECIPIENT=0xf17f52151EbEF6C7334FAD080c5704D77216b732
LIQUIDITY_COMMIT_REGISTRY_ADDRESS=0x0d8cc4b8d15d4c3ef1d70af0071376fb26b5669b
SOVEREIGN_HUB_TOKEN_B_ADDRESS=0x82d50ad3c1091866e258fd0f1a7cc9674609d254
SOVEREIGN_AMM_ADDRESS=0xecfcab0a285d3380e488a39b4bb21e777f8a4eac
SOVEREIGN_PAIR_AMM_MAP={"W-BRL-ARS":"0xecfcab0a285d3380e488a39b4bb21e777f8a4eac"}

# Simplified bridge/liquidity config (008-fix-cb-liquidity refactor)
SPOKE_NETWORK=spoke-b
NATIVE_ASSET_SYMBOL=tCeBM_ARS
W_TOKEN_ADDRESS=0x82d50ad3c1091866e258fd0f1a7cc9674609d254
# BANK_CODE=central-bank-b → CommitSide=B (derived automatically)
