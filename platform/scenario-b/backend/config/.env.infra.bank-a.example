# Infra (Compose)
KEYCLOAK_CONTAINER_NAME=cbweb3-keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ENV_OUTPUT_DIR=/opt/keycloak/host/backend/config
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

POSTGRES_CONTAINER_NAME=cbweb3-postgres
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=default
POSTGRES_PASSWORD=default
POSTGRES_DB_BANK_A=cbweb3_bank_a

REDIS_CONTAINER_NAME=cbweb3-redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379

# Domain defaults (bank-a)
KC_BASE_PATH=http://localhost:8081
KC_REALM=bank-a
KC_CLIENT_ID=bank-a-client
KC_CLIENT_SECRET=bank-a-local-secret
DB_NAME=cbweb3_bank_a
DATABASE_URL=postgres://default:default@${POSTGRES_CONTAINER_NAME:-cbweb3-postgres}:5432/cbweb3_bank_a?sslmode=disable

# Redis isolation — bank-a uses DB 0
REDIS_DB=0

# PKI — bank-a root CA (used to sign commercial bank CSRs)
# Local dev: generate with `openssl` — see backend/config/pki/README.md
CA_CERT_FILE=/workspace/backend/config/pki/bank-a-ca.crt
CA_KEY_FILE=/workspace/backend/config/pki/bank-a-ca.key
# Production (Docker Secrets): uncomment below and comment out the lines above
#CA_CERT_FILE=/run/secrets/ca.crt
#CA_KEY_FILE=/run/secrets/ca.key

# Blockchain — spoke-a Besu node (chain 1338)
# bank-a, bank-c and central-bank-a all share the same spoke-a Besu network.
# Contract addresses below are populated automatically by `make contracts.sync-addresses` after deployment.
# Local dev reference addresses (genesis deploy via `make deploy.up-with-contracts`):
BLOCKCHAIN_CLIENT=besu
BESU_RPC_URL=http://cbweb3-spoke-a-besu.bank-a:8545
BESU_CHAIN_ID=1338

# Populated automatically by `make contracts.sync-addresses` after deployment.
PARTICIPANT_REGISTRY_ADDRESS=0xde87af9156a223404885002669d3be239313ae33
TOKEN_ADDRESS=0x686afd6e502a81d2e77f2e038a23c0def4949a20
FIAT_TOKEN_ADDRESS=0x43d1f9096674b5722d359b6402381816d5b22f28
HTLC_ADDRESS=0x664d6ebabbd5cf656ed07a509affbc81f9615741
FX_AGREEMENT_ADDRESS=
SPOKE_BRIDGE_ADDRESS=0x9ab7ca8a88f8e351f9b0eeea5777929210199295

# Inter-entity communication — Central Bank API (for 3-phase onboarding)
# When set, the API Gateway acts as a commercial bank and proxies onboarding calls to the CB.
CENTRAL_BANK_API_URL=http://api-gateway-central-bank-a:8080

# Frontend dev server CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
BANK_A_FRONTEND_PORT=5173

# FX Agreement persistence (payment-orchestrator PostgreSQL)
# Points to the same Postgres instance as the API Gateway — uses same DATABASE_URL by default.
FX_POSTGRES_DSN=postgres://default:default@${POSTGRES_CONTAINER_NAME:-cbweb3-postgres}:5432/cbweb3_bank_a?sslmode=disable

# FX Agreement validation
# Rate tolerance: maximum allowed deviation between rate and counter_amount/origin_amount (fraction, default 0.1%).
FX_RATE_TOLERANCE_PCT=0.001

# Expiry worker: how often to scan for expired non-terminal agreements (seconds, default 300).
FX_EXPIRY_CHECK_INTERVAL_S=300

# Internal relay auth: shared secret for the X-Relay-Auth header — must match bank-b and cacti relay.
INTERNAL_RELAY_AUTH_SECRET=cbweb3-relay-shared-secret

# Payment Orchestrator gRPC address (optional; enables /api/v1/payments/* and /api/v1/token/* endpoints)
# When set on commercial banks: enables PaymentProxyHandler (proxy to Central Bank) + PaymentHandler (token balance).
# Format: payment-orchestrator-<entity>:9094
PAYMENT_GRPC_ADDR=payment-orchestrator-bank-a:9094

# Central Bank token recipient address (Besu address).
# Used by commercial banks for redeem flow: tokens are transferred to this address before de-tokenization request.
# Populated automatically by `deploy/local/tools/sync-contracts.sh` from contracts/.env private keys.
CB_TOKEN_RECIPIENT_ADDRESS=0x627306090abaB3A6e1400e9345bC60c78a8BEf57

# Strict agreement linkage for HTLC lock operations.
# Keep false in local dev while FX_AGREEMENT_ADDRESS is not configured.
FX_AGREEMENT_HTLC_STRICT=false

#BANK_B_FRONTEND_PORT=5174
#BANK_C_FRONTEND_PORT=5175
#BANK_D_FRONTEND_PORT=5176
#CENTRAL_BANK_A_FRONTEND_PORT=5177
#CENTRAL_BANK_B_FRONTEND_PORT=5178
AMM_CONTRACT_ADDRESS=0x05d91b9031a655d08e654177336d08543ac4b711
HUB_CHAIN_ID=1338
HUB_IDENTITY_REGISTRY_ADDRESS=0x42699a7612a82f1d9c36148af9c77354759b210b
HUB_TOKEN_A_ADDRESS=0xa50a51c09a5c451c52bb714527e1974b686d8e77
HUB_TOKEN_B_ADDRESS=0x9a3dbca554e9f6b9257aaa24010da8377c57c17e
PAIR_REGISTRY_CONTRACT_ADDRESS=0xfeae27388a65ee984f452f86effed42aabd438fd
SOVEREIGN_AMM_ADDRESS=0xecfcab0a285d3380e488a39b4bb21e777f8a4eac
SOVEREIGN_PAIR_AMM_MAP={"W-BRL-ARS":"0xecfcab0a285d3380e488a39b4bb21e777f8a4eac"}

# Simplified bridge/liquidity config — spoke identity and wrapped token for this bank's spoke
SPOKE_NETWORK=spoke-a
NATIVE_ASSET_SYMBOL=tCeBM_BRL
W_TOKEN_ADDRESS=0x75c35c980c0d37ef46df04d31a140b65503c0eed

# 009: Cacti relay URL for sovereign cross-currency bridge-out (CB-B via Cacti)
CACTI_API_URL=http://host.docker.internal:4000
