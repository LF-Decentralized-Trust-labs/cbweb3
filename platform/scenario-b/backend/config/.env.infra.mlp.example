# Infra (Compose)
KEYCLOAK_CONTAINER_NAME=cbweb3-keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ENV_OUTPUT_DIR=/opt/keycloak/host/backend/config
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

POSTGRES_CONTAINER_NAME=cbweb3-postgres
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=default
POSTGRES_PASSWORD=default
POSTGRES_DB_MLP=cbweb3_mlp

REDIS_CONTAINER_NAME=cbweb3-redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379

# Domain defaults (mlp)
KC_BASE_PATH=http://localhost:8081
KC_REALM=mlp
KC_CLIENT_ID=mlp-client
KC_CLIENT_SECRET=mlp-local-secret
DB_NAME=cbweb3_mlp
DATABASE_URL=postgres://default:default@${POSTGRES_CONTAINER_NAME:-cbweb3-postgres}:5432/cbweb3_mlp?sslmode=disable

# Redis isolation — MLP uses DB 6 (CB-A=2, CB-B=5)
REDIS_DB=6

# PKI — MLP root CA (required for governance bootstrap in compliance service)
# Local dev: generate with `make pki.gen-all` — see backend/config/pki/README.md
CA_CERT_FILE=/workspace/backend/config/pki/mlp-ca.crt
CA_KEY_FILE=/workspace/backend/config/pki/mlp-ca.key
# Production (Docker Secrets): uncomment below and comment out the lines above
#CA_CERT_FILE=/run/secrets/ca.crt
#CA_KEY_FILE=/run/secrets/ca.key

# Blockchain — Hub Besu node (chain 1338)
# MLP operates on the Hub network alongside CBs for liquidity provisioning.
# Contract addresses are populated automatically by `make contracts.sync-addresses`.
BLOCKCHAIN_CLIENT=besu
BESU_RPC_URL=http://cbweb3-spoke-a-besu:8545
BESU_CHAIN_ID=1338
CB_PRIVATE_KEY=

# IdentityRegistry — whitelist of approved participants (KYC/AML registry)
PARTICIPANT_REGISTRY_ADDRESS=0x42699a7612a82f1d9c36148af9c77354759b210b

# HashTimeLockedContract — atomic cross-chain swap escrow
HTLC_ADDRESS=

# AutomatedMarketMaker — on-chain FX liquidity pool
# Populated automatically by `make contracts.sync-addresses` after deployment.
AMM_CONTRACT_ADDRESS=

# Governance bootstrap — Keycloak service-account subject for mlp.
# Used by the compliance service (governance.go) on first startup.
GOVERNANCE_USER_ID=service-account-mlp-client

# Internal relay auth (R2-CR-6 migration). Real auth is the per-CB PKI signature
# (PKI_DIR/<BANK_CODE>.key); this shared secret is only a LEGACY FALLBACK for unsigned
# callers. Set RELAY_REQUIRE_SIGNATURE=true to enforce signatures post-cutover.
INTERNAL_RELAY_AUTH_SECRET=cbweb3-relay-shared-secret
RELAY_REQUIRE_SIGNATURE=false

# Payment Orchestrator gRPC address (optional; enables /api/v1/payments/* and /api/v1/token/* endpoints)
# Format: payment-orchestrator-<entity>:9094
PAYMENT_GRPC_ADDR=payment-orchestrator-mlp:9094

# Frontend dev server CORS
CORS_ALLOW_ORIGINS=http://localhost:3000

# Scenario B — Hub AMM liquidity pool (FR-004 / US2)
# MLP signer key — Besu genesis key #4 (pre-funded, registered as ParticipantRole.MLP).
# Private key: f8f8a2f43c8376ccb0871305060d7b27b0554d2cc72bccf41b2705608452f315
# Address:     0x22d491Bde2303f2f43325b2108D26f1eAbA1e32b
SIGNER_PRIVATE_KEY=f8f8a2f43c8376ccb0871305060d7b27b0554d2cc72bccf41b2705608452f315

# Hub tCeBM token addresses (required for approve before addLiquidity).
# Populated automatically by `make contracts.sync-addresses`.
HUB_TOKEN_A_ADDRESS=
HUB_TOKEN_B_ADDRESS=
