# deploy/local/.env — Feature toggles for local development.
#
# Usage:
#   cp deploy/local/.env.example deploy/local/.env
#   # then edit deploy/local/.env as needed
#
# This file is gitignored (deploy/local/.env). The .env.example is tracked.
# The Makefile loads it automatically via: -include deploy/local/.env

# ── MLP Path B — Multilateral Liquidity Provider ─────────────────────────────
# Set ENABLE_MLP=true to bring up the MLP stack (compliance-mlp, auth-mlp,
# payment-orchestrator-mlp, api-gateway-mlp) and register the MLP identity
# on-chain during `make scenario-b.deploy-contracts`.
#
# When false (default), the MLP realm is NOT provisioned in Keycloak and the
# MLP backend services are NOT started. No changes to the CB stack.
ENABLE_MLP=false

# Ethereum address of the MLP signer (Besu genesis key #4, pre-funded).
# The matching private key is a WELL-KNOWN, public Besu local-dev key and is
# intentionally NOT embedded here. For local dev it is provisioned through the
# entity config file (backend/config/.env.infra.mlp). NEVER use dev keys beyond
# a local machine. In staging/production, signing keys MUST come from a secret
# store / HSM via the KeyProvider abstraction — see docs/secret-management.md.
# Override to use a different key in integration environments.
MLP_ADDRESS=0x22d491Bde2303f2f43325b2108D26f1eAbA1e32b
