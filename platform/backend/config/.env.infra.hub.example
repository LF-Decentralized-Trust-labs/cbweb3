# Infra (Compose)
KEYCLOAK_CONTAINER_NAME=cbweb3-keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ENV_OUTPUT_DIR=/opt/keycloak/host/backend/config
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

POSTGRES_CONTAINER_NAME=cbweb3-postgres
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=default
POSTGRES_PASSWORD=default
POSTGRES_DB_HUB=cbweb3_hub

REDIS_CONTAINER_NAME=cbweb3-redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379

# Domain defaults (hub)
KC_BASE_PATH=http://localhost:8081
KC_REALM=cbweb3
KC_CLIENT_ID=cbweb3-auth
DB_NAME=cbweb3_hub
DATABASE_URL=postgres://default:default@localhost:5432/cbweb3_hub?sslmode=disable
#HUB_ACCEPTED_ISSUERS=cbweb3-spoke-a,cbweb3-spoke-b

# PKI — Central Bank root CA (required to sign CSRs and for governance bootstrap)
# Local dev: generate with `openssl` — see backend/config/pki/README.md
CA_CERT_FILE=/workspace/backend/config/pki/hub-ca.crt
CA_KEY_FILE=/workspace/backend/config/pki/hub-ca.key
# Production (Docker Secrets): uncomment below and comment out the lines above
#CA_CERT_FILE=/run/secrets/ca.crt
#CA_KEY_FILE=/run/secrets/ca.key

# Blockchain — hub Besu node (noop by default; enable for on-chain writes)
BLOCKCHAIN_CLIENT=noop
#BLOCKCHAIN_CLIENT=besu
#BESU_RPC_URL=http://hub-besu:8545
#PARTICIPANT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
#CB_PRIVATE_KEY=
#BESU_CHAIN_ID=1337

# Governance bootstrap — Keycloak subject created automatically by init.sh
GOVERNANCE_USER_ID=service-account-cbweb3-auth
