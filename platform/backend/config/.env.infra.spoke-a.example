# Infra (Compose)
KEYCLOAK_CONTAINER_NAME=cbweb3-keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ENV_OUTPUT_DIR=/opt/keycloak/host/backend/config
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

POSTGRES_CONTAINER_NAME=cbweb3-postgres
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=default
POSTGRES_PASSWORD=default
POSTGRES_DB_SPOKE_A=cbweb3_spoke_a

REDIS_CONTAINER_NAME=cbweb3-redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379

# Domain defaults (spoke-a)
KC_BASE_PATH=http://localhost:8081
KC_REALM=cbweb3-spoke-a
KC_CLIENT_ID=cbweb3-spoke-a-client
DB_NAME=cbweb3_spoke_a
DATABASE_URL=postgres://default:default@localhost:5432/cbweb3_spoke_a?sslmode=disable

# PKI — spoke root CA (used to sign commercial bank CSRs)
# Local dev: generate with `openssl` — see backend/config/pki/README.md
CA_CERT_FILE=/workspace/backend/config/pki/spoke-a-ca.crt
CA_KEY_FILE=/workspace/backend/config/pki/spoke-a-ca.key
# Production (Docker Secrets): uncomment below and comment out the lines above
#CA_CERT_FILE=/run/secrets/ca.crt
#CA_KEY_FILE=/run/secrets/ca.key

# Blockchain — spoke-a Besu node (chain 1338)
# Spoke-A hosts regional contracts: IdentityRegistry + domestic tCeBM token
BLOCKCHAIN_CLIENT=noop
#BLOCKCHAIN_CLIENT=besu
#BESU_RPC_URL=http://spoke-besu-a:8545
#BESU_CHAIN_ID=1338
#CB_PRIVATE_KEY=
#PARTICIPANT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
#TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Governance bootstrap — Keycloak subject for the regional Central Bank of spoke A
GOVERNANCE_USER_ID=service-account-cbweb3-spoke-a-client
