# Infra (Compose)
KEYCLOAK_CONTAINER_NAME=cbweb3-keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ENV_OUTPUT_DIR=/opt/keycloak/host/backend/config
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

POSTGRES_CONTAINER_NAME=cbweb3-postgres
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=default
POSTGRES_PASSWORD=default
POSTGRES_DB_BANK_A=cbweb3_bank_a

REDIS_CONTAINER_NAME=cbweb3-redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379

# Domain defaults (bank-a)
KC_BASE_PATH=http://localhost:8081
KC_REALM=bank-a
KC_CLIENT_ID=bank-a-client
DB_NAME=cbweb3_bank_a
DATABASE_URL=postgres://default:default@localhost:5432/cbweb3_bank_a?sslmode=disable

# Redis isolation — bank-a uses DB 0
REDIS_DB=0

# PKI — bank-a root CA (used to sign commercial bank CSRs)
# Local dev: generate with `openssl` — see backend/config/pki/README.md
CA_CERT_FILE=/workspace/backend/config/pki/bank-a-ca.crt
CA_KEY_FILE=/workspace/backend/config/pki/bank-a-ca.key
# Production (Docker Secrets): uncomment below and comment out the lines above
#CA_CERT_FILE=/run/secrets/ca.crt
#CA_KEY_FILE=/run/secrets/ca.key

# Blockchain — spoke-a Besu node (chain 1338)
# bank-a, bank-b and central-bank all share the same spoke-a Besu network.
# Contract addresses below are populated automatically by `make contracts.sync-addresses` after deployment.
# Local dev reference addresses (genesis deploy via `make deploy.up-with-contracts`):
BLOCKCHAIN_CLIENT=noop
#BLOCKCHAIN_CLIENT=besu
#BESU_RPC_URL=http://cbweb3-spoke-a-besu.bank-a:8545
#BESU_CHAIN_ID=1338
#CB_PRIVATE_KEY=

# IdentityRegistry — whitelist of approved participants for spoke-a
#PARTICIPANT_REGISTRY_ADDRESS=0x42699a7612a82f1d9c36148af9c77354759b210b

# TokenizedCentralBankMoney — domestic tCeBM token issued by spoke-a central bank
#TOKEN_ADDRESS=0xa50a51c09a5c451c52bb714527e1974b686d8e77

# HashTimeLockedContract — atomic cross-chain swap escrow for spoke-a
#HTLC_ADDRESS=0x9a3dbca554e9f6b9257aaa24010da8377c57c17e

# SpokeBridge — bridge contract that connects spoke-a to the hub chain
#SPOKE_BRIDGE_ADDRESS=0x9b8397f1b0fecd3a1a40cdd5e8221fa461898517

# Inter-entity communication — Central Bank API (for 3-phase onboarding)
# The commercial bank uses these to submit credential requests and complete onboarding.
CENTRAL_BANK_API_URL=http://central-bank-gateway:38080
CENTRAL_BANK_API_KEY=

# todo: check if this is correct
# Governance bootstrap — Keycloak subject for bank-a  ?????
GOVERNANCE_USER_ID=service-account-bank-a-client
