# Infra (Compose)
KEYCLOAK_CONTAINER_NAME=keycloak
KEYCLOAK_PORT=8081
KEYCLOAK_ENV_OUTPUT_DIR=/opt/keycloak/host/backend/config
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

POSTGRES_CONTAINER_NAME=postgres
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=default
POSTGRES_PASSWORD=default
POSTGRES_DB_SPOKE_B=cbweb3_spoke_b

REDIS_CONTAINER_NAME=cbweb3-redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379

# Domain defaults (spoke-b)
KC_BASE_PATH=http://localhost:8081
KC_REALM=cbweb3-spoke-b
KC_CLIENT_ID=cbweb3-spoke-b-client
DB_NAME=cbweb3_spoke_b
DATABASE_URL=postgres://default:default@localhost:5432/cbweb3_spoke_b?sslmode=disable
