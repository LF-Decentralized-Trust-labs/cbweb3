# NOC Stack — Environment Variables
# Copy this file to .env and fill in values for your environment.

# ── PostgreSQL (noc-db) ──────────────────────────────────────────────────────
POSTGRES_USER=noc
POSTGRES_PASSWORD=noc_secret_change_me
POSTGRES_DB=nocdb

# ── noc-backend ──────────────────────────────────────────────────────────────
NOC_BACKEND_PORT=8090

# Keycloak integration
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=cbweb3
KEYCLOAK_CLIENT_ID=noc-portal
KEYCLOAK_CLIENT_SECRET=

# NOC Frontend origin for CORS (e.g. http://localhost:5173 for local dev)
NOC_FRONTEND_ORIGIN=http://localhost:5173

# Grace period multiplier: agent UNKNOWN after (push_interval × this value) seconds
AGENT_GRACE_MULTIPLIER=3
