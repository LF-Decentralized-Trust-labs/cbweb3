nodeName: spoke-a-bank-c

log:
  level: debug

db:
  sqlite:
    dsn: "/data/paladin.db"
    autoMigrate: true
    migrationsDir: "./db/migrations/sqlite"
    debugQueries: false

rpcServer:
  enabled: true
  http:
    port: 8548
    address: 0.0.0.0
  ws:
    port: 8549
    address: 0.0.0.0

# Besu node-2 for spoke-a (host port 8647/8657)
blockchain:
  http:
    url: "http://host.docker.internal:8647"
  ws:
    url: "ws://host.docker.internal:8657"

transports:
  grpc:
    plugin:
      type: "c-shared"
      library: "/app/transports/libgrpc.so"
    config:
      port: 9000
      address: 0.0.0.0
      externalHostname: paladin-spoke-a-bank-c
      tls:
        certFile: /etc/paladin/tls.crt
        keyFile: /etc/paladin/tls.key

domains:
  zeto:
    registryAddress: "${ZETO_FACTORY_ADDRESS}"
    allowSigning: true
    fixedSigningIdentity: "funded_operator"
    plugin:
      type: "c-shared"
      library: "/app/domains/libzeto.so"
    config:
      domainContracts:
        implementations:
          - name: "Zeto_Anon"
            circuits:
              deposit:
                name: "deposit"
              withdraw:
                name: "withdraw"
              transfer:
                name: "anon"
              transferLocked:
                name: "anon"
      snarkProver:
        circuitsDir: "/app/domains/zeto/zkp"
        provingKeysDir: "/app/domains/zeto/zkp"

registries:
  evm-registry:
    plugin:
      type: "c-shared"
      library: "/app/registries/libevm.so"
    config:
      contractAddress: "${REGISTRY_CONTRACT_ADDRESS}"

wallets:
  - name: "funded_wallet"
    keySelector: "^funded_operator$"
    signer:
      keyStore:
        type: static
        static:
          keys:
            funded_operator:
              encoding: hex
              inline: "5b02fc9b19facc6de72b514a03db7f7fbd9f46b6ad6ffb24b8df575593ae87f1"
      keyDerivation:
        type: direct
  - name: "hd_wallet"
    keySelector: ".*"
    signer:
      keyStore:
        type: filesystem
        filesystem:
          path: /data/keystore
      keyDerivation:
        type: bip32

publicTxManager:
  gasLimit:
    gasEstimateFactor: 2.0
  gasPrice:
    fixedGasPrice:
      maxFeePerGas: "1000000000"
      maxPriorityFeePerGas: "0"

persistence:
  leveldb:
    path: "/data/leveldb"
