nodeName: spoke-b-bank-b

log:
  level: debug

db:
  sqlite:
    dsn: ":memory:"
    autoMigrate: true
    migrationsDir: "./db/migrations/sqlite"
    debugQueries: false

rpcServer:
  enabled: true
  http:
    port: 8548
    address: 0.0.0.0
  ws:
    port: 8549
    address: 0.0.0.0

# Besu node-1 for spoke-b (host port 8746/8756)
blockchain:
  http:
    url: "http://host.docker.internal:8746"
  ws:
    url: "ws://host.docker.internal:8756"

transports:
  grpc:
    plugin:
      type: "c-shared"
      library: "/app/transports/libgrpc.so"
    config:
      port: 9000
      address: 0.0.0.0
      externalHostname: paladin-spoke-b-bank-b
      tls:
        certFile: /etc/paladin/tls.crt
        keyFile: /etc/paladin/tls.key

domains:
  zeto:
    registryAddress: "${ZETO_FACTORY_ADDRESS}"
    allowSigning: true
    fixedSigningIdentity: "funded_operator"
    plugin:
      type: "c-shared"
      library: "/app/domains/libzeto.so"
    config:
      domainContracts:
        implementations:
          - name: "Zeto_AnonNullifier"
            circuits:
              deposit:
                name: "deposit"
              withdraw:
                name: "withdraw_nullifier"
                usesNullifiers: true
              transfer:
                name: "anon_nullifier_transfer"
                usesNullifiers: true
              transferLocked:
                name: "anon_nullifier_transferLocked"
                usesNullifiers: true
      snarkProver:
        circuitsDir: "/app/domains/zeto/zkp"
        provingKeysDir: "/app/domains/zeto/zkp"

registries:
  evm-registry:
    plugin:
      type: "c-shared"
      library: "/app/registries/libevm.so"
    config:
      contractAddress: "${REGISTRY_CONTRACT_ADDRESS}"

wallets:
  - name: "funded_wallet"
    keySelector: "^funded_operator$"
    signer:
      keyStore:
        type: static
        static:
          keys:
            funded_operator:
              encoding: hex
              inline: "ae6ae8e5ccbfb04590405997ee2d52d2b330726137b875053c36d94e974d162f"
      keyDerivation:
        type: direct
  - name: "hd_wallet"
    keySelector: ".*"
    signer:
      keyStore:
        type: filesystem
        filesystem:
          path: /data/keystore
      keyDerivation:
        type: bip32

publicTxManager:
  gasLimit:
    gasEstimateFactor: 2.0
  gasPrice:
    fixedGasPrice:
      maxFeePerGas: "1000000000"
      maxPriorityFeePerGas: "0"

persistence:
  leveldb:
    path: "/data/leveldb"
