FOUNDRY_PROFILE=default

# ── Signing keys ─────────────────────────────────────────────────────────────
# Every *_PRIVATE_KEY value below is intentionally BLANK. For local dev, fill the
# COPIED file (.env) with the well-known, pre-funded Besu genesis keys — public dev
# keys that must NEVER be used beyond a local machine. In staging/production,
# signing keys MUST be sourced from a secret store / HSM via the KeyProvider
# abstraction and never written to disk or env files — see docs/secret-management.md.

# Deployer (Besu genesis account #1 for local dev)
DEPLOYER_PRIVATE_KEY=

# Governance admin key used for IdentityRegistry writes
ADMIN_PRIVATE_KEY=

# RBAC addresses (use Besu genesis accounts for local dev)
ADMIN_ADDRESS=
CENTRAL_BANK_ADDRESS=

# Hub Besu (chain 1337)
HUB_RPC_URL=http://127.0.0.1:8545

# Spoke-A Besu (chain 1338)
SPOKE_A_RPC_URL=http://127.0.0.1:8645

# Spoke-B Besu (chain 1339)
SPOKE_B_RPC_URL=http://127.0.0.1:8745

# Legacy: standalone script support (defaults to hub)
BESU_RPC_URL=http://127.0.0.1:8545
TOKEN_A_ADDRESS=
TOKEN_B_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
