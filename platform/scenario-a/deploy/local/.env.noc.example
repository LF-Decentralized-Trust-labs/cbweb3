# NOC Stack — Environment Variables
# Copy this file to .env.noc and fill in your values.
# Usage: docker compose -f compose.noc.yml --env-file .env.noc up -d

# ─── NOC Database ────────────────────────────────────────────────────────────
NOC_DB_CONTAINER_NAME=cbweb3-noc-db
NOC_DB_USER=noc
NOC_DB_PASSWORD=change_me
NOC_DB_NAME=cbweb3_noc

# ─── NOC Backend ─────────────────────────────────────────────────────────────
NOC_BACKEND_CONTAINER_NAME=cbweb3-noc-backend
NOC_BACKEND_PORT=8090

# Set to true ONLY for local development (disables Keycloak JWT validation)
NOC_SKIP_AUTH=false

# Multiplier applied to push_interval_seconds before marking an agent offline
AGENT_GRACE_MULTIPLIER=3

# ─── Keycloak (must match the Keycloak realm config) ─────────────────────────
KEYCLOAK_URL=http://cbweb3-keycloak:8080
KEYCLOAK_REALM=cbweb3
KEYCLOAK_CLIENT_ID=noc-portal
KEYCLOAK_CLIENT_SECRET=

# ─── NOC Portal (frontend) ───────────────────────────────────────────────────
NOC_PORTAL_CONTAINER_NAME=cbweb3-noc-portal
NOC_PORTAL_PORT=5900

# CORS origin that noc-backend will allow (must match the portal's public URL)
NOC_FRONTEND_ORIGIN=http://localhost:5900

# Build-time Vite vars — baked into the static bundle at docker build
VITE_NOC_BACKEND_URL=http://localhost:8090/api/v1
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=cbweb3
VITE_KEYCLOAK_CLIENT_ID=noc-portal
