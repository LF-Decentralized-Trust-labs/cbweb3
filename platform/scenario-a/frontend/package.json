{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:bank": "npm run dev --workspace=bank --",
    "dev:supervisor": "npm run dev --workspace=supervisor --",
    "dev:treasury": "npm run dev --workspace=treasury --",
    "dev:noc": "npm run dev --workspace=noc --",
    "dev:governance": "npm run dev --workspace=governance --",
    "dev:dispatcher": "npm run dev --workspace=dispatcher --"
  },
  "license": "ISC"
}
