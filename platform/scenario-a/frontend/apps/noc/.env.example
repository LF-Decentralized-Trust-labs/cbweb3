# NOC Frontend — Environment Variables
# Copy to .env.local for development

# NOC Backend base URL (http-client prepends /api/v1 automatically)
VITE_NOC_BACKEND_URL=http://localhost:8090/api/v1

# Keycloak (must match noc-backend's KEYCLOAK_* vars)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=cbweb3
VITE_KEYCLOAK_CLIENT_ID=noc-portal
