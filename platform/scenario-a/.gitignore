.github/agents/*
!.github/agents/speckit*.agent.md
.github/copilot-instructions.md.agent/
.agent/

# Custom agent assets
.github/assets/*
!.github/assets/README.md

# Docs-reference
docs-reference/

# Go Coverage
backend/**/*.out

# Foundry
contracts/cache/
contracts/out/
!contracts/broadcast
contracts/broadcast/*/1337/
contracts/broadcast/*/1338/
contracts/broadcast/*/1339/
contracts/broadcast/*/31337/
contracts/broadcast/**/dry-run/
contracts/*.flattened.*
contracts/dependencies

# IDEs
# Cursor: ignorar .cursor/ exceto skills do Spec Kit (partilha com a equipa)
.cursor/*
!.cursor/skills/
.cursor/skills/*
!.cursor/skills/speckit-*/
.vscode/
.idea/

# Git worktrees
.worktrees/


# Besu
*/**/tmpFiles
deploy/local/spoke-besu-b/tmpFiles/
deploy/local/hub-besu/tmpFiles/

# PKI — local CA credentials (never commit private keys or certificates)
*.key
*.crt
*.pem
*.srl
*.csr

# Go Workspace files
*/**/go.work
*/**/go.work.sum
.agent/

openspec/
# Prompts do Copilot — versionar apenas Spec Kit
.github/prompts/*
!.github/prompts/speckit*.prompt.md
.github/skills/

# sample deploy artifacts (toolkit CLI binary + emitted join bundles)
/samples/.cbweb3
/samples/bundles/*.bundle.yaml

# spoke runtime data dir (relative node.dataDir resolved against CWD; see samples/README.md)
cbweb3-data/

# Generated provisioning state. The Paladin deployment scripts write the deployed
# contract addresses next to themselves, and since they moved from deploy/local (which
# was ignored wholesale) into provisioning/ (which is tracked), the state needs an
# explicit rule. Caught by the gitleaks gate when a run's addresses were committed.
**/.deployed-addrs.env
provisioning/paladin/*/
!provisioning/paladin/scripts/
!provisioning/paladin/contracts/
