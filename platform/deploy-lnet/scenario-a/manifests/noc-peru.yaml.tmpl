# yaml-language-server: $schema=../../../scenario-a/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario A (Enhanced Correspondent Banking).
# NOC (Network Operations Center) DATA PLANE for spoke-peru, CO-LOCATED on the
# Central Bank Peru VM (${IP_CB_PERU}) — no dedicated VM.
#
# Unlike Scenario B, the NOC PORTAL is deployed by central-bank-peru's `found`
# (it already builds the noc frontend + provisions the cbweb3 Keycloak realm and
# points VITE_NOC_BACKEND_URL at this host's :28645). This observe run only stands
# up the control-plane DATA PLANE — Postgres + noc-backend on :28645 in its own
# docker network — plus the founding CB's noc-agent. It runs NO on-chain node.
#
# The agents live WITH each entity: central-bank-peru (this observe run, same
# VM → host.docker.internal:28645) and each joining bank (cb5/cb6, other VMs →
# spec.noc.backendURL: http://${IP_CB_PERU}:28645) push their own node health.
apiVersion: cbweb3/v1
kind: ParticipantDeployment
metadata:
  name: noc-peru
spec:
  scenario: a
  environment: local
  role: noc
  mode: observe
  displayName: NOC — spoke-peru
  # NOC bundle emitted by central-bank-peru (found) and relocated by deploy.sh
  # into the scenario-a spoke folder (scenario-scoped, so a Scenario B
  # spoke-peru NOC bundle never overwrites it). Local on this VM (co-located).
  nocBundleRef: ../../bundles/scenario-a/spoke-peru/spoke-peru.noc.bundle.yaml
  # Optional tuning; the agent defaults to a 15s push cadence and all bundle
  # components. Scenario A's NOC bundle carries the CB Besu node only.
  noc:
    pushIntervalSeconds: 15
    components: [BESU]
    # Realm the BACKEND performs the password grant against — it moved off the browser when
    # the NOC session became an HttpOnly cookie. central-bank-peru's Keycloak on this VM
    # (Besu RPC 8645 + 16000). Unused while the stack runs with NOC_SKIP_AUTH=true (the
    # default), and what NOC_SKIP_AUTH=false needs in order to be reachable at all.
    keycloakURL: http://${IP_CB_PERU}:24645
  # The portal is served by central-bank-peru's `found`, behind THIS host's proxy at
  # /a/noc/ — so the backend has to be routed there too, same-origin, at /a/noc-api/. Both
  # fields are load-bearing for that:
  #
  #   proxy: enable   runs the observe deployment's start-noc-proxy step, which writes the
  #                   /a/noc-api/ route. Without it the portal calls a route that does not
  #                   exist, and the browser gets a 404 with nothing pointing at the cause.
  #   frontendHost    is the origin the backend answers CORS with (https://<host>). Absent,
  #                   it resolved to http://localhost:32645 — an origin no browser on a
  #                   remote VM will ever present, so no portal could log in.
  frontendHost: cb-peru.cbweb3.l-net.io
  proxy: enable
