# yaml-language-server: $schema=../../../scenario-a/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario A. VM ${IP_CB_COLOMBIA} — Central Bank Colombia, FOUNDS spoke-colombia (COP).
# Independent spoke; the Cacti relay on ${IP_HUB} bridges Brazil <-> Colombia (correspondent banking).
# Emits ./bundles/spoke-colombia.bundle.yaml for cb3/cb4 to join.
apiVersion: cbweb3/v1
kind: ParticipantDeployment
metadata:
  name: central-bank-colombia
spec:
  scenario: a
  environment: local
  role: central-bank
  mode: found
  displayName: Banco de la República (Colombia)
  spoke:
    id: spoke-colombia
    chainId: 2024
    currency: COP
  node:
    advertisedHost: ${IP_CB_COLOMBIA}
    rpc: { port: 8645 }
    ws:  { port: 8655 }
    p2p: { port: 30303 }
    dataDir: /opt/cbweb3/data/scenario-a/spoke-colombia
  image: build
  keyProvider: kms://local-emulator
  certSource: self-signed://local
  relay:
    endpoint: http://${IP_HUB}:4000
    advertisedHost: ${IP_CB_COLOMBIA}
  cbEndpoint: http://${IP_CB_COLOMBIA}:18645/api/v1/credential-request
  frontendHost: cb-colombia.cbweb3.lnet.io
  launcher: enable
  launcherPort: 5190
  adminUsers:
    - { role: ROLE_GOVERNANCE, username: governance@cb-colombia.lnet.io, password: change-me-local }
    - { role: ROLE_TREASURY,   username: treasury@cb-colombia.lnet.io,   password: change-me-local }
    - { role: ROLE_SUPERVISOR, username: supervisor@cb-colombia.lnet.io, password: change-me-local }
    - { role: ROLE_NOC_ADMIN,  username: noc@cb-colombia.lnet.io,        password: change-me-local }
