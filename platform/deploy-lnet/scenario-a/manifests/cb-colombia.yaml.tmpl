# yaml-language-server: $schema=../../../scenario-a/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario A. VM ${IP_CB_COLOMBIA} — Central Bank Colombia, FOUNDS spoke-colombia (COP).
# Independent spoke; the Cacti relay on ${IP_HUB} bridges Brazil <-> Colombia (correspondent banking).
# dataDir + emitted join bundle under deploy-lnet/bundles/scenario-a/spoke-colombia/
apiVersion: cbweb3/v1
kind: ParticipantDeployment
metadata:
  name: central-bank-colombia
spec:
  scenario: a
  environment: local
  role: central-bank
  mode: found
  displayName: Banco de la República (Colombia)
  spoke:
    id: spoke-colombia
    chainId: 2024
    currency: COP
    # ERC-20 metadata of this spoke's own fCeBM (the public Besu-layer fiat token).
    # Optional — absent, both derive from `currency` (exactly the values below).
    # Declared explicitly so each spoke's token identity is auditable in config.
    # The symbol must keep the "<prefix>_<ISO>" shape and end in this spoke's own
    # currency; `currency` stays the semantic key the portals display (FIAT_SYMBOL).
    # Scenario A deploys no tCeBM: the tokenised side is a Zeto privacy token, which
    # has no ERC-20 symbol — so fCeBM is the only configurable token identity here.
    fiatTokenName: Fiat COP
    fiatTokenSymbol: fCeBM_COP
  node:
    advertisedHost: ${IP_CB_COLOMBIA}
    rpc: { port: 8645 }
    ws:  { port: 8655 }
    p2p: { port: 30303 }
    dataDir: ../deploy-lnet/bundles/scenario-a/spoke-colombia
  image: build
  keyProvider: kms://local-emulator
  certSource: self-signed://local
  relay:
    endpoint: http://${IP_HUB}:4000
    advertisedHost: ${IP_CB_COLOMBIA}
  cbEndpoint: http://${IP_CB_COLOMBIA}:18645/api/v1/credential-request
  frontendHost: cb-colombia.cbweb3.l-net.io
  launcher: enable
  launcherPort: 5190
  proxy: enable
  adminUsers:
    - { role: ROLE_GOVERNANCE, username: governance@cb-colombia.l-net.io, password: change-me-local }
    - { role: ROLE_TREASURY,   username: treasury@cb-colombia.l-net.io,   password: change-me-local }
    - { role: ROLE_SUPERVISOR, username: supervisor@cb-colombia.l-net.io, password: change-me-local }
    - { role: ROLE_NOC_ADMIN,  username: noc@cb-colombia.l-net.io,        password: change-me-local }
