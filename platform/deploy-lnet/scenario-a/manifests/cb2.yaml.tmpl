# yaml-language-server: $schema=../../../scenario-a/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario A. VM ${IP_CB2} — commercial bank cb2, JOINS spoke-brazil.
apiVersion: cbweb3/v1
kind: ParticipantDeployment
metadata:
  name: bank-cb2-brazil
spec:
  scenario: a
  environment: local
  role: commercial-bank
  mode: join
  bankId: cb2
  displayName: Commercial Bank cb2 (Brazil)
  spoke:
    id: spoke-brazil
    chainId: 2021
    currency: BRL
  joinBundleRef: ../../bundles/scenario-a/spoke-brazil/spoke-brazil.bundle.yaml
  node:
    advertisedHost: ${IP_CB2}
    rpc: { port: 8645 }
    ws:  { port: 8655 }
    p2p: { port: 30303 }
    dataDir: ../deploy-lnet/bundles/scenario-a/cb2
  image: build
  keyProvider: kms://local-emulator
  certSource: self-signed
  relay:
    endpoint: http://${IP_HUB}:4000
  frontendHost: cb2-brazil.cbweb3.l-net.io
  launcher: enable
  launcherPort: 5190
  noc:
    backendURL: http://${IP_CB_BRAZIL}:28645
    pushIntervalSeconds: 15
  proxy: enable
  adminUsers:
    - { role: ROLE_BANK, username: admin@cb2.l-net.io, password: change-me-local }
