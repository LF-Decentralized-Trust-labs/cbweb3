# yaml-language-server: $schema=../../../scenario-a/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario A. VM ${IP_CB1} — commercial bank cb1, JOINS spoke-costa-rica.
# joinBundleRef -> deploy-lnet/bundles/scenario-a/spoke-costa-rica/spoke-costa-rica.bundle.yaml
# (scp the bundle emitted on ${IP_CB_COSTA_RICA} into that path before apply).
# dataDir is per-bank so .provisioning-state.yaml never mixes with the CB spoke.
apiVersion: cbweb3/v1
kind: ParticipantDeployment
metadata:
  name: bank-cb1-costa-rica
spec:
  scenario: a
  environment: local
  role: commercial-bank
  mode: join
  bankId: cb1
  displayName: Commercial Bank cb1 (Costa Rica)
  spoke:
    id: spoke-costa-rica
    chainId: 2021
    currency: CRC
  joinBundleRef: ../../bundles/scenario-a/spoke-costa-rica/spoke-costa-rica.bundle.yaml
  node:
    advertisedHost: ${IP_CB1}
    rpc: { port: 8645 }
    ws:  { port: 8655 }
    p2p: { port: 30303 }
    dataDir: ../deploy-lnet/bundles/scenario-a/cb1
  image: build
  keyProvider: kms://local-emulator
  certSource: self-signed
  relay:
    endpoint: http://${IP_HUB}:4000
  frontendHost: cb1-costa-rica.cbweb3.l-net.io
  launcher: enable
  launcherPort: 5190
  noc:
    backendURL: http://${IP_CB_COSTA_RICA}:28645
    pushIntervalSeconds: 15
  proxy: enable
  adminUsers:
    - { role: ROLE_BANK, username: admin@cb1.l-net.io, password: change-me-local }
