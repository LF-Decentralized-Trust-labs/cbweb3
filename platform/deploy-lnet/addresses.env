# LNET deployment addressing — single source of truth for the per-VM IPs.
#
# Edit the defaults here, OR override any of them by exporting the variable before
# running render.sh / deploy.sh (an already-exported value wins over the default).
# These feed the ${IP_*} markers in every *.yaml.tmpl (Besu enode advertisedHost,
# relay endpoint/advertisedHost, cbEndpoint). No secrets — just routable addresses.

export IP_HUB="${IP_HUB:-10.10.0.20}"                 # hub + both Cacti relays (VM .20)
export IP_CB_BRAZIL="${IP_CB_BRAZIL:-10.10.0.21}"     # Central Bank Brazil spoke (VM .21)
export IP_CB1="${IP_CB1:-10.10.0.22}"                 # commercial bank cb1 (VM .22)
export IP_CB2="${IP_CB2:-10.10.0.23}"                 # commercial bank cb2 (VM .23)
export IP_CB_COLOMBIA="${IP_CB_COLOMBIA:-10.10.0.24}" # Central Bank Colombia spoke (VM .24)
export IP_CB3="${IP_CB3:-10.10.0.25}"                 # commercial bank cb3 (VM .25)
export IP_CB4="${IP_CB4:-10.10.0.26}"                 # commercial bank cb4 (VM .26)
