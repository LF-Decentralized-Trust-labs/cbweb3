# LNET deployment addressing — single source of truth for the per-VM IPs.
#
# Edit the defaults here, OR override any of them by exporting the variable before
# running render.sh / deploy.sh (an already-exported value wins over the default).
# These feed the ${IP_*} markers in every *.yaml.tmpl (Besu enode advertisedHost,
# relay endpoint/advertisedHost, cbEndpoint). No secrets — just routable addresses.
#
# Topology: one hub VM + three countries, each a central bank founding its own
# spoke plus two commercial banks joining it.
#   Costa Rica → CB .21, banks cb1 .22 / cb2 .23
#   Chile      → CB .24, banks cb3 .25 / cb4 .26
#   Peru       → CB .30, banks cb5 .31 / cb6 .32

export IP_HUB="${IP_HUB:-10.10.0.20}"                     # hub + both Cacti relays (VM .20)

# Costa Rica
export IP_CB_COSTA_RICA="${IP_CB_COSTA_RICA:-10.10.0.21}" # Central Bank Costa Rica spoke (VM .21)
export IP_CB1="${IP_CB1:-10.10.0.22}"                     # commercial bank cb1 — Costa Rica (VM .22)
export IP_CB2="${IP_CB2:-10.10.0.23}"                     # commercial bank cb2 — Costa Rica (VM .23)

# Chile
export IP_CB_CHILE="${IP_CB_CHILE:-10.10.0.24}"           # Central Bank Chile spoke (VM .24)
export IP_CB3="${IP_CB3:-10.10.0.25}"                     # commercial bank cb3 — Chile (VM .25)
export IP_CB4="${IP_CB4:-10.10.0.26}"                     # commercial bank cb4 — Chile (VM .26)

# Peru
export IP_CB_PERU="${IP_CB_PERU:-10.10.0.30}"             # Central Bank Peru spoke (VM .30)
export IP_CB5="${IP_CB5:-10.10.0.31}"                     # commercial bank cb5 — Peru (VM .31)
export IP_CB6="${IP_CB6:-10.10.0.32}"                     # commercial bank cb6 — Peru (VM .32)
