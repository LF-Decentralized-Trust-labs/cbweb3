# ship.sh configuration — copy to `.env` (same folder as ship.sh) and edit.
# ship.sh auto-loads ./.env; just run `./ship.sh`. A variable exported on the
# command line overrides the file: `DEPLOY_HOST=1.2.3.4 ./ship.sh`.
#
# `.env` is gitignored; never commit real hosts, keys, or passwords.

# --- target (required) ------------------------------------------------------
DEPLOY_HOST=10.10.0.20            # deploy machine hostname or IP
DEPLOY_USER=ubuntu                # SSH user (defaults to $USER if unset)
DEPLOY_PORT=22                    # SSH port
# Remote extraction directory. Do NOT use a bare `~` here — it would expand to
# YOUR local home when .env is loaded. Use a path relative to the remote home
# (recommended) or an absolute remote path (e.g. /home/ubuntu/cbweb3-platform).
DEPLOY_DEST=cbweb3-platform       # -> resolves under the remote user's home

# --- auth: key OR password --------------------------------------------------
# Auto-detected when unset: key if DEPLOY_KEY is set, else password if
# DEPLOY_PASSWORD is set, else key with the agent/default identity.
DEPLOY_AUTH=key                   # key | password

# key auth — path to the private key (omit to use the ssh-agent/default identity)
DEPLOY_KEY=~/.ssh/lnet

# password auth — requires `sshpass` locally.
# brew install hudochenkov/sshpass/sshpass
# DEPLOY_AUTH=password
# DEPLOY_PASSWORD=change-me

# --- optional ---------------------------------------------------------------
DEPLOY_STRICT_HOST_KEY=accept-new # yes | no | accept-new
# DEPLOY_EXTRA_EXCLUDES="*/.venv */__pycache__"   # extra tar --exclude patterns
