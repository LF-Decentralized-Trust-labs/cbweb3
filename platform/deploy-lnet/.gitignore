# Rendered manifests — generated from *.yaml.tmpl by render.sh / deploy.sh.
# The *.yaml.tmpl templates are the source of truth; never commit the rendered output.
/hub/manifests/*.yaml
/scenario-a/manifests/*.yaml
/scenario-b/manifests/*.yaml

# Local toolkit binaries built by deploy.sh
/.bin/

# Central bundles drop-zone (public bundles + hub runtime state)
/bundles/hub/**
!/bundles/hub/.gitkeep
/bundles/scenario-a/**
!/bundles/scenario-a/.gitkeep
/bundles/scenario-b/**
!/bundles/scenario-b/.gitkeep

# Optional local address override
/addresses.local.env

# Local ship.sh config — may hold hosts/keys/passwords. The tracked sample is .env.sample.
/.env
