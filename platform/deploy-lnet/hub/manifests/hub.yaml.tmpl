# yaml-language-server: $schema=../../../scenario-b/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario B (International Hub). VM ${IP_HUB} — HUB + Cacti relay (shared .20 infra).
# Manifests live under hub/manifests/; bundles (dataDir + hub.bundle.yaml) under deploy-lnet/bundles/hub/.
# Spokes consume via hubBundleRef: ../../bundles/hub/hub.bundle.yaml.
apiVersion: cbweb3b/v1
kind: ParticipantDeployment
metadata:
  name: hub-cbweb3
spec:
  scenario: "b"
  environment: local
  mode: found-hub
  topology:
    role: hub
  displayName: CBWeb3 International Hub
  hub:
    chainId: 1337 
  node:
    advertisedHost: ${IP_HUB}
    rpc: { port: 8845 }
    ws:  { port: 8846 }
    p2p: { port: 30304 }           # Scenario B uses 30304 so it never clashes with Scenario A's 30303
    dataDir: bundles/hub             # under deploy-lnet/ (state + hub.bundle.yaml drop-zone)
  image: build
  keyProvider: kms://local-emulator
  certSource: self-signed
  relay:
    endpoint: http://${IP_HUB}:7000   # Scenario B Cacti relay (co-located on the hub VM)
  frontendHost: hub.cbweb3.l-net.io
  adminUsers:
    - { role: GOVERNANCE, username: governance@hub.l-net.io, password: change-me-local }
    - { role: NOC_ADMIN,  username: noc@hub.l-net.io,        password: change-me-local }
