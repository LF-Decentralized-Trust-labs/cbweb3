# yaml-language-server: $schema=../../../scenario-b/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario B. VM ${IP_CB_COSTA_RICA} — Central Bank Costa Rica, FOUNDS spoke-costa-rica (CRC).
# Consumes ../../bundles/hub/hub.bundle.yaml (scp'd from ${IP_HUB}).
# dataDir + emitted join bundle under deploy-lnet/bundles/scenario-b/spoke-costa-rica/
apiVersion: cbweb3b/v1
kind: ParticipantDeployment
metadata:
  name: central-bank-costa-rica
spec:
  scenario: "b"
  environment: local
  mode: found-spoke
  topology:
    role: central-bank
  displayName: Banco Central de Costa Rica
  spoke:
    id: spoke-costa-rica
    chainId: 2022
    currency: CRC
    # ERC-20 metadata of THIS spoke's own tokens (tCeBM reserve + fCeBM fiat).
    # Optional: absent, they derive from `currency` — exactly the values below.
    # Declared explicitly so each sovereign spoke's token is auditable in config
    # and changing it never requires touching code. Symbols must keep the
    # "<prefix>_<ISO>" shape: portals and the api-gateway read the currency code
    # from the segment after the last underscore.
    tokenName: Tokenized CRC
    tokenSymbol: tCeBM_CRC
    fiatTokenName: Fiat CRC
    fiatTokenSymbol: fCeBM_CRC
  hubBundleRef: ../../bundles/hub/hub.bundle.yaml
  node:
    advertisedHost: ${IP_CB_COSTA_RICA}   # routable VM IP -> spoke-bundle enode dialable by cb1/cb2
    rpc: { port: 8845 }
    ws:  { port: 8846 }
    p2p: { port: 30304 }
    # Relative to deploy-lnet/ (deploy.sh --data-dir overrides to the absolute path).
    dataDir: bundles/scenario-b/spoke-costa-rica
  image: build
  keyProvider: kms://local-emulator
  certSource: self-signed            # the CB is the CA of its own spoke
  relay:
    endpoint: http://${IP_HUB}:7000
    advertisedHost: ${IP_CB_COSTA_RICA}   # host the relay on .20 uses to reach this spoke
  cbEndpoint: http://${IP_CB_COSTA_RICA}:16845   # api-gateway = rpc+8000
  frontendHost: cb-costa-rica.cbweb3.l-net.io
  launcher: enable
  launcherPort: 5190
  proxy: enable
  adminUsers:
    # Baseline lab operator accounts (one per role). Placeholder passwords — rotate
    # out of band (Keycloak) before real use; never commit real credentials.
    - { role: GOVERNANCE, username: governance@cb-costa-rica.l-net.io, password: change-me-local }
    - { role: TREASURY,   username: treasury@cb-costa-rica.l-net.io,   password: change-me-local }
    - { role: SUPERVISOR, username: supervisor@cb-costa-rica.l-net.io, password: change-me-local }
    - { role: NOC,        username: noc@cb-costa-rica.l-net.io,        password: change-me-local }
    # --- Banco Central de Costa Rica (BCCR) testing team ---------------------
    # Each holds the full set of central-bank roles (governance + treasury +
    # supervisor + NOC). The same username repeated across role entries is seeded
    # once in Keycloak and granted every role (create users || true; add-roles).
    # Passwords are placeholders — provision unique per-user passwords out of band.
    - { role: GOVERNANCE, username: user-governance@cb-costa-rica.l-net.io,  password: change-me-local }
    - { role: TREASURY,   username: user-governance@cb-costa-rica.l-net.io,  password: change-me-local }
    - { role: SUPERVISOR, username: user-governance@cb-costa-rica.l-net.io,  password: change-me-local }
    - { role: NOC,        username: user-governance@cb-costa-rica.l-net.io,  password: change-me-local }
    - { role: GOVERNANCE, username: user-governance@cb-costa-rica.l-net.io,    password: change-me-local }
    - { role: TREASURY,   username: user-governance@cb-costa-rica.l-net.io,    password: change-me-local }
    - { role: SUPERVISOR, username: user-governance@cb-costa-rica.l-net.io,    password: change-me-local }
    - { role: NOC,        username: user-governance@cb-costa-rica.l-net.io,    password: change-me-local }
    - { role: GOVERNANCE, username: user-governance@cb-costa-rica.l-net.io,   password: change-me-local }
    - { role: TREASURY,   username: user-governance@cb-costa-rica.l-net.io,   password: change-me-local }
    - { role: SUPERVISOR, username: user-governance@cb-costa-rica.l-net.io,   password: change-me-local }
    - { role: NOC,        username: user-governance@cb-costa-rica.l-net.io,   password: change-me-local }
