# yaml-language-server: $schema=../../../scenario-b/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario B. VM ${IP_CB2} — commercial bank cb2, JOINS spoke-brazil.
apiVersion: cbweb3b/v1
kind: ParticipantDeployment
metadata:
  name: cb2
spec:
  scenario: "b"
  environment: local
  mode: join
  topology:
    role: commercial-bank
  bankId: cb2
  displayName: Commercial Bank cb2 (Brazil)
  spoke:
    id: spoke-brazil
    chainId: 2022
    currency: BRL
  joinBundleRef: ../bundles/spoke-brazil.bundle.yaml
  node:
    advertisedHost: ${IP_CB2}
    rpc: { port: 8845 }
    ws:  { port: 8846 }
    p2p: { port: 30304 }
    dataDir: /opt/cbweb3/data/scenario-b/cb2
    validator: false
  image: build
  keyProvider: kms://local-emulator
  certSource: ca://central-bank-brazil
  relay:
    endpoint: http://${IP_HUB}:7000
  frontendHost: cb2-brazil.cbweb3.lnet.io
  launcher: enable
  launcherPort: 5190
  adminUsers:
    - { role: BANK, username: admin@cb2.lnet.io, password: change-me-local }
