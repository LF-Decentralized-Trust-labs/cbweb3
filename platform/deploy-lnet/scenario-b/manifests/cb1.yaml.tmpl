# yaml-language-server: $schema=../../../scenario-b/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario B. VM ${IP_CB1} — commercial bank cb1, JOINS spoke-costa-rica.
# joinBundleRef -> deploy-lnet/bundles/scenario-b/spoke-costa-rica/spoke-costa-rica.bundle.yaml
# (scp the bundle emitted on ${IP_CB_COSTA_RICA} into that path before apply).
# dataDir is per-bank so .provisioning-state.yaml never mixes with the CB spoke.
apiVersion: cbweb3b/v1
kind: ParticipantDeployment
metadata:
  name: cb1
spec:
  scenario: "b"
  environment: local
  mode: join
  topology:
    role: commercial-bank
  bankId: cb1
  displayName: Commercial Bank cb1 (Costa Rica)
  spoke:
    id: spoke-costa-rica
    chainId: 2022
    currency: CRC
  joinBundleRef: ../../bundles/scenario-b/spoke-costa-rica/spoke-costa-rica.bundle.yaml
  node:
    advertisedHost: ${IP_CB1}
    rpc: { port: 8845 }
    ws:  { port: 8846 }
    p2p: { port: 30304 }
    dataDir: bundles/scenario-b/cb1
    validator: false
  image: build
  keyProvider: kms://local-emulator
  certSource: ca://central-bank-costa-rica
  relay:
    endpoint: http://${IP_HUB}:7000
  noc:
    backendURL: http://${IP_CB_COSTA_RICA}:8090
  frontendHost: cb1-costa-rica.cbweb3.l-net.io
  launcher: enable
  launcherPort: 5190
  proxy: enable
  adminUsers:
    - { role: BANK, username: admin@cb1.l-net.io, password: change-me-local }
