# yaml-language-server: $schema=../../../scenario-b/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario B. VM ${IP_CB1} — commercial bank cb1, JOINS spoke-brazil.
# joinBundleRef -> deploy-lnet/bundles/scenario-b/spoke-brazil/spoke-brazil.bundle.yaml
# (scp the bundle emitted on ${IP_CB_BRAZIL} into that path before apply).
apiVersion: cbweb3b/v1
kind: ParticipantDeployment
metadata:
  name: cb1
spec:
  scenario: "b"
  environment: local
  mode: join
  topology:
    role: commercial-bank
  bankId: cb1
  displayName: Commercial Bank cb1 (Brazil)
  spoke:
    id: spoke-brazil
    chainId: 2022
    currency: BRL
  joinBundleRef: ../../bundles/scenario-b/spoke-brazil/spoke-brazil.bundle.yaml
  node:
    advertisedHost: ${IP_CB1}
    rpc: { port: 8845 }
    ws:  { port: 8846 }
    p2p: { port: 30304 }
    dataDir: bundles/scenario-b/spoke-brazil
    validator: false
  image: build
  keyProvider: kms://local-emulator
  certSource: ca://central-bank-brazil
  relay:
    endpoint: http://${IP_HUB}:7000
  frontendHost: cb1-brazil.cbweb3.lnet.io
  launcher: enable
  launcherPort: 5190
  adminUsers:
    - { role: BANK, username: admin@cb1.lnet.io, password: change-me-local }
