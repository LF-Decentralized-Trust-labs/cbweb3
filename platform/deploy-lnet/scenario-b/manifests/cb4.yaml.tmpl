# yaml-language-server: $schema=../../../scenario-b/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario B. VM ${IP_CB4} — commercial bank cb4, JOINS spoke-colombia.
apiVersion: cbweb3b/v1
kind: ParticipantDeployment
metadata:
  name: cb4
spec:
  scenario: "b"
  environment: local
  mode: join
  topology:
    role: commercial-bank
  bankId: cb4
  displayName: Commercial Bank cb4 (Colombia)
  spoke:
    id: spoke-colombia
    chainId: 2025
    currency: COP
  joinBundleRef: ../../bundles/scenario-b/spoke-colombia/spoke-colombia.bundle.yaml
  node:
    advertisedHost: ${IP_CB4}
    rpc: { port: 8845 }
    ws:  { port: 8846 }
    p2p: { port: 30304 }
    dataDir: bundles/scenario-b/cb4
    validator: false
  image: build
  keyProvider: kms://local-emulator
  certSource: ca://central-bank-colombia
  relay:
    endpoint: http://${IP_HUB}:7000
  noc:
    backendURL: http://${IP_CB_COLOMBIA}:8090
  frontendHost: cb4-colombia.cbweb3.l-net.io
  launcher: enable
  launcherPort: 5190
  adminUsers:
    - { role: BANK, username: admin@cb4.l-net.io, password: change-me-local }
