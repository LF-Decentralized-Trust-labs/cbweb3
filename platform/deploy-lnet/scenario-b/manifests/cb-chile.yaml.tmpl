# yaml-language-server: $schema=../../../scenario-b/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario B. VM ${IP_CB_CHILE} — Central Bank Chile, FOUNDS spoke-chile (CLP).
# Consumes ../../bundles/hub/hub.bundle.yaml (scp'd from ${IP_HUB}).
# dataDir + emitted join bundle under deploy-lnet/bundles/scenario-b/spoke-chile/
# NOTE: sovereign pairs (cross-currency corridor + AMM) are deferred — opened later via the governance portal.
apiVersion: cbweb3b/v1
kind: ParticipantDeployment
metadata:
  name: central-bank-chile
spec:
  scenario: "b"
  environment: local
  mode: found-spoke
  topology:
    role: central-bank
  displayName: Banco Central de Chile
  spoke:
    id: spoke-chile
    chainId: 2025
    currency: CLP
    # ERC-20 metadata of THIS spoke's own tokens (tCeBM reserve + fCeBM fiat).
    # Optional: absent, they derive from `currency` — exactly the values below.
    # Declared explicitly so each sovereign spoke's token is auditable in config
    # and changing it never requires touching code. Symbols must keep the
    # "<prefix>_<ISO>" shape: portals and the api-gateway read the currency code
    # from the segment after the last underscore.
    tokenName: Tokenized CLP
    tokenSymbol: tCeBM_CLP
    fiatTokenName: Fiat CLP
    fiatTokenSymbol: fCeBM_CLP
  hubBundleRef: ../../bundles/hub/hub.bundle.yaml
  node:
    advertisedHost: ${IP_CB_CHILE}
    rpc: { port: 8845 }
    ws:  { port: 8846 }
    p2p: { port: 30304 }
    dataDir: bundles/scenario-b/spoke-chile
  image: build
  keyProvider: kms://local-emulator
  certSource: self-signed
  relay:
    endpoint: http://${IP_HUB}:7000
    advertisedHost: ${IP_CB_CHILE}
  cbEndpoint: http://${IP_CB_CHILE}:16845
  frontendHost: cb-chile.cbweb3.l-net.io
  launcher: enable
  launcherPort: 5190
  proxy: enable
  adminUsers:
    - { role: GOVERNANCE, username: governance@cb-chile.l-net.io, password: change-me-local }
    - { role: TREASURY,   username: treasury@cb-chile.l-net.io,   password: change-me-local }
    - { role: SUPERVISOR, username: supervisor@cb-chile.l-net.io, password: change-me-local }
    - { role: NOC,        username: noc@cb-chile.l-net.io,        password: change-me-local }
