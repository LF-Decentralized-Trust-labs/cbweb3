# yaml-language-server: $schema=../../../scenario-b/provisioning/schema/v1/participant-deployment.schema.yaml
# LNET deploy — Scenario B. VM ${IP_CB_COLOMBIA} — Central Bank Colombia, FOUNDS spoke-colombia (COP).
# Consumes ../bundles/hub.bundle.yaml (scp'd from ${IP_HUB}).
# Emits ./bundles/spoke-colombia.bundle.yaml for cb3/cb4 to join.
# NOTE: sovereign pair (BRL/COP corridor + AMM) is deferred — opened later via the governance portal.
apiVersion: cbweb3b/v1
kind: ParticipantDeployment
metadata:
  name: central-bank-colombia
spec:
  scenario: "b"
  environment: local
  mode: found-spoke
  topology:
    role: central-bank
  displayName: Banco de la República (Colombia)
  spoke:
    id: spoke-colombia
    chainId: 2025
    currency: COP
  hubBundleRef: ../../bundles/hub.bundle.yaml
  node:
    advertisedHost: ${IP_CB_COLOMBIA}
    rpc: { port: 8845 }
    ws:  { port: 8846 }
    p2p: { port: 30304 }
    dataDir: /opt/cbweb3/data/scenario-b/spoke-colombia
  image: build
  keyProvider: kms://local-emulator
  certSource: self-signed
  relay:
    endpoint: http://${IP_HUB}:7000
    advertisedHost: ${IP_CB_COLOMBIA}
  cbEndpoint: http://${IP_CB_COLOMBIA}:16845
  frontendHost: cb-colombia.cbweb3.lnet.io
  launcher: enable
  launcherPort: 5190
  adminUsers:
    - { role: GOVERNANCE, username: governance@cb-colombia.lnet.io, password: change-me-local }
    - { role: TREASURY,   username: treasury@cb-colombia.lnet.io,   password: change-me-local }
    - { role: SUPERVISOR, username: supervisor@cb-colombia.lnet.io, password: change-me-local }
