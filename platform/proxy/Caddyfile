# CBWeb3 reverse proxy — a single HTTP(S) entrypoint per entity host.
#
# Path-based routing: each portal is served under /<scenario>/<role>/ (e.g.
# /a/governance/, /b/bank/) and each scenario's api-gateway under /<scenario>/api/.
# Per-scenario route fragments are written by each scenario's toolkit into
# /etc/caddy/conf.d/caddy.<scenario>.conf and imported here; the per-entity launcher
# landing page answers everything else at the site root.
#
# The image is GENERIC — no per-entity hosts or ports are baked in. Both scenarios of
# an entity share ONE proxy container on that host.
#
# TLS: set PROXY_SITE to the entity's public host (spec.frontendHost) to serve HTTPS on
# :443 with an automatic :80→:443 redirect. The certificate source is PROXY_TLS_DIRECTIVE:
#   ""                                        → automatic ACME / Let's Encrypt (the host
#                                                must be reachable from the internet on 80/443)
#   "tls internal"                            → Caddy's local CA (self-signed; browsers warn
#                                                until the CA root is trusted). Default.
#   "tls /certs/proxy.crt /certs/proxy.key"   → operator-provided certificate (mount /certs)
# Leave PROXY_SITE unset (default :80) to serve plain HTTP only — no TLS.

{$PROXY_SITE::80} {
	# TLS source (empty ⇒ automatic ACME for the site host); injected verbatim by the
	# toolkit. A blank line here when unset is intentional and valid.
	{$PROXY_TLS_DIRECTIVE:}

	# Per-scenario portal + api routes (caddy.a.conf, caddy.b.conf). Each fragment uses
	# `handle_path` / `handle` blocks with explicit path matchers, so they are evaluated
	# before the match-all launcher fallback below. A zero-match glob is not an error, so
	# a host running only one scenario still starts cleanly.
	import /etc/caddy/conf.d/*.conf

	# Fallback (matcher-less `handle` = matched last): the per-entity launcher. Its own
	# step publishes it on the host, so the proxy reaches it via host.docker.internal.
	# Override with LAUNCHER_UPSTREAM when the launcher port differs from the default.
	handle {
		reverse_proxy {$LAUNCHER_UPSTREAM:host.docker.internal:5190}
	}
}
