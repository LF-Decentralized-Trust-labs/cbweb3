# CBWeb3 Toolbox - Environment Configuration
# All values are SYNTHETIC — safe to commit and share.
# See: Toolbox/sandbox/devnet-guide/mock-server-setup.md

# ─── Mock Server ─────────────────────────────────────────────
# Base URL for the Prism mock server (or any CBWeb3 API implementation)
CBWEB3_BASE_URL=http://localhost:4010

# Synthetic Bearer token for testing (not a real JWT)
CBWEB3_AUTH_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.SYNTHETIC_TOKEN_CB001

# ─── Network Identity (reference only) ───────────────────────
# These are NOT used by the Toolbox directly.
# They document the synthetic corridor used in all test data.
CBWEB3_NETWORK=devnet
CBWEB3_CHAIN_ID=12345

# ─── Synthetic Participants ──────────────────────────────────
# Initiator: Central Bank A
CB_INITIATOR_ADDRESS=0xCB001_CountryA
CB_INITIATOR_CURRENCY=tCeBM-A

# Counterparty: Central Bank B
CB_COUNTERPARTY_ADDRESS=0xCB002_CountryB
CB_COUNTERPARTY_CURRENCY=tCeBM-B

# ─── Synthetic HTLC Values ───────────────────────────────────
# Secret and hash used in all PvP test vectors
HTLC_SECRET=cbweb3-test-secret-2026
HTLC_HASHLOCK=0x7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069

# ─── Backend Services (reference only — not needed for Toolbox) ─
# Uncomment and set these if connecting to a real CBWeb3 deployment
# AUTH_SERVICE_URL=http://localhost:8080
# PAYMENT_ORCHESTRATOR_URL=http://localhost:8081
# COMPLIANCE_SERVICE_URL=http://localhost:8082
# LIQUIDITY_MONITOR_URL=http://localhost:8083
